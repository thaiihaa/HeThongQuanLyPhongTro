# Backend — sao chép thành .env (không commit .env)
SERVER_PORT=8082

# SQL Server: set only after verifying the normal T-SQL TCP endpoint and its port.
# Do not use port 1434 here: current SQL Server metadata maps it to Dedicated Admin Connection (DAC).
# Cách 1: Windows Integrated Authentication.
# Đặt JAVA_HOME/PATH và JAVA_TOOL_OPTIONS trong cùng PowerShell trước khi chạy Java;
# Spring không tự đọc .env. Xem README để dùng JDK/DLL đã xác minh.
# JAVA_TOOL_OPTIONS=-Djava.library.path=D:\path\to\backend
# Replace <VERIFIED_TSQL_PORT> with the regular SQL Server T-SQL TCP listener port.
# DB_URL=jdbc:sqlserver://<SQL_SERVER>:<VERIFIED_TSQL_PORT>;databaseName=QuanLyPhongTro;integratedSecurity=true;encrypt=true;trustServerCertificate=true
DB_USERNAME=
DB_PASSWORD=

# Cách 2: SQL Server Authentication (bỏ integratedSecurity, điền user/password ứng dụng)
# DB_URL=jdbc:sqlserver://<SQL_SERVER>:<VERIFIED_TSQL_PORT>;databaseName=QuanLyPhongTro;encrypt=true;trustServerCertificate=true
# DB_USERNAME=qlpt_app
# DB_PASSWORD=

# Hibernate: none (mặc định) | validate (khi đã có schema khớp entity)
JPA_DDL_AUTO=none

# Bootstrap chỉ chạy khi bật rõ ràng; dùng giá trị riêng ở môi trường local, không commit .env.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_TENANT_ENABLED=false
BOOTSTRAP_TENANT_USERNAME=
BOOTSTRAP_TENANT_EMAIL=
BOOTSTRAP_TENANT_PHONE=
BOOTSTRAP_TENANT_PASSWORD=
BOOTSTRAP_TENANT_FULL_NAME=

# Set SPRING_PROFILES_ACTIVE=dev separately before enabling demo users.
# Demo bootstrap requires a local/dev/development profile and is refused for prod/production.
# For local learning only, set each password to 123456 as requested; change immediately.
APP_BOOTSTRAP_DEMO_USERS=false
APP_BOOTSTRAP_DEMO_ADMIN_PASSWORD=
APP_BOOTSTRAP_DEMO_TENANT_PASSWORD=
SESSION_EXPIRATION_SECONDS=43200

# CORS cho Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chưa có JWT flow trong backend; chỉ cấu hình secret ngẫu nhiên qua biến môi trường khi triển khai auth.
# JWT_SECRET=
JWT_EXPIRATION_MS=86400000
